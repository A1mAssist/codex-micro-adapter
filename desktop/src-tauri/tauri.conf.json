{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Codex Micro",
  "version": "0.1.0",
  "identifier": "dev.a1massist.codex-micro",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [
      {
        "title": "Codex Micro",
        "width": 1180,
        "height": 800,
        "minWidth": 940,
        "minHeight": 620
      }
    ],
    "withGlobalTauri": true,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
